    <decisions>
        <description>Will Check Suppliers  Agreement End Date</description>
        <name>Suppliers_Agreement_End_Date_Checked</name>
        <label>Suppliers  Agreement End Date Checked</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsTrue</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Agreement_End_Date__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Today_Plus_1</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Agreement_End_Date__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Today_Plus_15</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Agreement_End_Date__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Today_Plus_30</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CC_Email_Assignment</targetReference>
            </connector>
            <label>IsTrue</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Daysleft</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Agreement_End_Date__c} - TODAY()</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <description>Will give today&apos;s date Plus one day</description>
        <name>Today_Plus_1</name>
        <dataType>Date</dataType>
        <expression>TODAY() +1</expression>
    </formulas>
    <formulas>
        <description>Will give today&apos;s date Plus 15 day</description>
        <name>Today_Plus_15</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 15</expression>
    </formulas>
    <formulas>
        <description>Will give today&apos;s date Plus 30 day</description>
        <name>Today_Plus_30</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 30</expression>
    </formulas>
