    </formulas>
    <formulas>
        <name>SubjectForReschdule</name>
        <dataType>String</dataType>
        <expression>&quot;Invitation: &quot; &amp; {!$Record.Candidate__r.Name} &amp; 
&quot; (&quot; &amp; {!$Record.Job_Position__r.Job_Title__c} &amp; &quot;) on &quot; &amp; 

CASE(
  MOD(DATEVALUE({!$Record.Interview_Date__c}) - DATE(1900,1,7),7),
  0,&quot;Sunday&quot;,
  1,&quot;Monday&quot;,
  2,&quot;Tuesday&quot;,
  3,&quot;Wednesday&quot;,
  4,&quot;Thursday&quot;,
  5,&quot;Friday&quot;,
  6,&quot;Saturday&quot;,&quot;&quot;
) &amp; &quot;, &quot; &amp; 
TEXT(DATEVALUE({!$Record.Interview_Date__c})) &amp; &quot;, &quot; &amp; 

/* Start Time */
TEXT(
   CASE(
      MOD(HOUR(TIMEVALUE({!$Record.Interview_Date__c})),12),
      0, 12,
      HOUR(TIMEVALUE({!$Record.Interview_Date__c}))
   )
) &amp; &quot;:&quot; &amp;
LPAD(TEXT(MINUTE(TIMEVALUE({!$Record.Interview_Date__c}))),2,&quot;0&quot;) &amp; &quot; &quot; &amp;
IF(HOUR(TIMEVALUE({!$Record.Interview_Date__c})) &lt; 12, &quot;AM&quot;, &quot;PM&quot;)

&amp; &quot; - &quot; &amp;

/* End Time */
TEXT(
   CASE(
      MOD(HOUR(TIMEVALUE({!$Record.Interview_Date__c} + (30/1440))),12),
      0, 12,
      HOUR(TIMEVALUE({!$Record.Interview_Date__c} + (30/1440)))
   )
) &amp; &quot;:&quot; &amp;
LPAD(TEXT(MINUTE(TIMEVALUE({!$Record.Interview_Date__c} + (30/1440)))),2,&quot;0&quot;) &amp; &quot; &quot; &amp;
IF(HOUR(TIMEVALUE({!$Record.Interview_Date__c} + (30/1440))) &lt; 12, &quot;AM&quot;, &quot;PM&quot;)</expression>
    </formulas>
    <formulas>
