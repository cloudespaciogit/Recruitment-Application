            </value>
        </inputParameters>
        <inputParameters>
            <name>composeEmailContent</name>
            <value>
                <stringValue>True</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>subjectforemail</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <stringValue>&lt;p&gt;Hi {!$Record.Recruiter__r.Name},&lt;/p&gt;&lt;p&gt;This is a reminder that the current Client agreement is approaching its expiration date and requires your attention.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;&lt;u&gt;Client details&lt;/u&gt;&lt;/strong&gt;&lt;u&gt;:&lt;/u&gt;&lt;/p&gt;&lt;p&gt;Name:&lt;strong&gt; &lt;/strong&gt;&lt;a href=&quot;https://cloudespaciosoftwareprivat5-dev-ed.develop.lightning.force.com/lightning/r/Client__c/{!$Record.Id}/view&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;&lt;strong&gt;{!$Record.Name}&lt;/strong&gt;&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Phone: {!$Record.Phone__c}&amp;nbsp;&amp;nbsp;&lt;/p&gt;&lt;p&gt;Email: {!$Record.Email__c}&amp;nbsp;&amp;nbsp;&lt;/p&gt;&lt;p&gt;Agreement End Date:  &lt;strong&gt;{!$Record.Agreement_End_Date__c}&amp;nbsp;&amp;nbsp;&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Remaining Days: &lt;strong&gt;{!Days_Left} &lt;/strong&gt;Day(s)&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Please take the necessary steps to either initiate the renewal process or begin the contract termination procedure, as appropriate. You may also wish to discuss potential extension or renewal options directly with the Client.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Best regards,&amp;nbsp;&amp;nbsp;&lt;/p&gt;&lt;p&gt;Management Team&amp;nbsp;&amp;nbsp;&lt;/p&gt;&lt;p&gt;{!$Organization.Name}&lt;/p&gt;&lt;p&gt;{!$Organization.Phone}&lt;/p&gt;</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sendRichBody</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientId</name>
            <value>
                <elementReference>$Record.Recruiter__r.Email__c</elementReference>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <offset>0</offset>
        <versionString>1.0.1</versionString>
