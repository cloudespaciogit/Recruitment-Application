    <decisions>
        <description>Will check Client Agreement End date</description>
        <name>ClientAgreementEndDateCheck</name>
        <label>Client Agreement End Date Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsTrue</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Agreement_End_Date__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Today_plus_1</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Agreement_End_Date__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Today_plus_15</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Agreement_End_Date__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Today_plus_30</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reciepient_Id_Collection_assignment</targetReference>
            </connector>
            <label>IsTrue</label>
        </rules>
    </decisions>
    <description>Will send custom notification and email to recruiter if agreement is about to end .</description>
    <environments>Default</environments>
    <formulas>
        <name>Days_Left</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Agreement_End_Date__c} - TODAY()</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>FormattedEndData</name>
        <dataType>String</dataType>
        <expression>LPAD(TEXT(DAY($Record.Agreement_End_Date__c)), 2, &quot;0&quot;) &amp; &quot;/&quot; &amp;
LPAD(TEXT(MONTH($Record.Agreement_End_Date__c)), 2, &quot;0&quot;) &amp; &quot;/&quot; &amp;
RIGHT(TEXT(YEAR($Record.Agreement_End_Date__c)), 2)</expression>
    </formulas>
    <formulas>
        <description>Will send email to the recruiter before 1 day of agreement ends</description>
        <name>Today_plus_1</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 1</expression>
    </formulas>
    <formulas>
        <description>Will send email to the recruiter before 15 day of agreement ends</description>
        <name>Today_plus_15</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 15</expression>
    </formulas>
    <formulas>
        <description>Will send email to the recruiter before 30 day of agreement ends</description>
        <name>Today_plus_30</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 30</expression>
    </formulas>
