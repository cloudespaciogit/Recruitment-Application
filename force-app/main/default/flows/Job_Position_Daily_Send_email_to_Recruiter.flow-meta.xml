    <environments>Default</environments>
    <formulas>
        <name>JobPositionURL</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_290}, FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_290}) - 1)</expression>
    </formulas>
    <formulas>
        <name>PriorityColourScheme</name>
        <dataType>String</dataType>
        <expression>IF(
  TEXT({!Loop_through_Jobs.Priority__c}) = &quot;High&quot;,
  &quot;&lt;b style=&apos;color:red&apos;&gt;High&lt;/b&gt;&quot;,
  IF(
    TEXT({!Loop_through_Jobs.Priority__c}) = &quot;Medium&quot;,
    &quot;&lt;b style=&apos;color:orange&apos;&gt;Medium&lt;/b&gt;&quot;,
    IF(
      TEXT({!Loop_through_Jobs.Priority__c}) = &quot;Low&quot;,
      &quot;&lt;b style=&apos;color:green&apos;&gt;Low&lt;/b&gt;&quot;,
      &quot;&lt;b&gt;&quot; &amp; TEXT({!Loop_through_Jobs.Priority__c}) &amp; &quot;&lt;/b&gt;&quot;
    )
  )
)</expression>
    </formulas>
