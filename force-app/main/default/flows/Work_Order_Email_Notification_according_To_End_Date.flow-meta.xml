        <name>Body15Days</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Hi &lt;strong&gt;{!$Record.Recruiter__r.Name}&lt;/strong&gt;,&lt;/p&gt;&lt;p&gt;This is a reminder that the current work order for the candidate {!$Record.Candidate__r.Name} is approaching its end date. Please take the necessary steps to extend, reassign, or close the assignment as needed.&lt;/p&gt;&lt;h3&gt;Work Order Details:&lt;/h3&gt;&lt;ul&gt;&lt;li&gt;&lt;strong style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Work Order: &lt;/strong&gt;&lt;a href=&quot;https://cloudespaciosoftwareprivat5-dev-ed.develop.lightning.force.com/builder_platform_interaction/%7B!URL%7D&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;color: rgb(1, 118, 211); background-color: rgb(255, 255, 255);&quot;&gt;&lt;strong&gt;{!$Record.Name}&lt;/strong&gt;&lt;/a&gt;&lt;/li&gt;&lt;li&gt;&lt;strong style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Candidate Name:&lt;/strong&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt; {!$Record.Candidate__r.Name} &lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Candidate Email:&lt;/strong&gt; {!$Record.Candidate__r.Email__c}&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Project Name:&lt;/strong&gt; {!$Record.Project__r.Name}&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Client:&lt;/strong&gt; &lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;{!$Record.Project__r.Client__r.Name}&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Work Order End Date:&lt;/strong&gt; {!$Record.End_Date__c}&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Remaining Days:&lt;/strong&gt; 15 Days&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Kindly review the candidate&apos;s performance and discuss next steps with the project manager or client as appropriate.&lt;/p&gt;&lt;p&gt;Let us know if you need any assistance.&lt;/p&gt;&lt;p&gt;Best regards,&lt;/p&gt;&lt;p&gt;&lt;strong&gt;{!$Organization.Name}&lt;/strong&gt;&lt;/p&gt;</text>
    </textTemplates>
