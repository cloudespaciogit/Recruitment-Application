<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Close_Reason_When_Candidate_Coun</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status, &quot;Completed&quot;),
  Candidates_to_submit__c &gt; Actual_Candidate_submitted__c,
  ISBLANK(Incomplete_Submission_Reason__c),
  $RecordType.DeveloperName = &quot;Recruiter_Page_Layout&quot;
)</errorConditionFormula>
    <errorMessage>Candidate submissions do not match the target. An Incomplete Submission Reason is required to complete this record.</errorMessage>
</ValidationRule>
