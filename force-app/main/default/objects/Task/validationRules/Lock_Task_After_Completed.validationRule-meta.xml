<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lock_Task_After_Completed</fullName>
    <active>false</active>
    <errorConditionFormula>ISPICKVAL(PRIORVALUE(Status), &quot;Completed&quot;)</errorConditionFormula>
    <errorMessage>This Task has already been completed and cannot be edited.</errorMessage>
</ValidationRule>
