<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Login_Logout_When_Working</fullName>
    <active>true</active>
    <description>Makes login mandatory when status = Working</description>
    <errorConditionFormula>AND(
    TEXT(Status__c) = &quot;Working&quot;,    
        ISBLANK(Login_Time__c)    
)</errorConditionFormula>
    <errorMessage>Login time is required when Status is Working.</errorMessage>
</ValidationRule>
